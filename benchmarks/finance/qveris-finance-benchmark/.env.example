# QVeris Finance Benchmark — Environment Variables
# Copy to .env and fill in your values.

# QVeris API (required for qveris-cli and qveris-mcp variants)
QVERIS_API_KEY=your-qveris-api-key
# QVERIS_BASE_URL=https://api.qveris.ai

# LLM Judge (optional — for Layer 2 scoring)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=your-judge-api-key
ANTHROPIC_JUDGE_MODEL=deepseek-v4-pro

# Agent API key (for http adapter)
# OPENAI_API_KEY=your-openai-api-key
# AGENT_API_KEY=your-agent-api-key

# Local binary overrides (optional)
# QVERIS_CODEX_BIN=/path/to/codex          # codex binary when not on PATH
# QVERIS_NODE_BIN=/path/to/node/bin        # Node bin dir prepended to PATH by run-claude-benchmark.sh
