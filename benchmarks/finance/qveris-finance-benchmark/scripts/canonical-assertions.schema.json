{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["canonical_assertions", "assertion_decisions"],
  "properties": {
    "canonical_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field_id", "entity_json", "value_json", "unit", "currency", "financial_period_json", "adjustment_basis", "trading_day_window_json", "formula", "tolerance_json", "verification_status"],
        "properties": {
          "field_id": { "type": "string" },
          "entity_json": { "type": "string" },
          "value_json": { "type": "string" },
          "unit": { "type": ["string", "null"] },
          "currency": { "type": ["string", "null"] },
          "financial_period_json": { "type": ["string", "null"] },
          "adjustment_basis": { "type": ["string", "null"] },
          "trading_day_window_json": { "type": ["string", "null"] },
          "formula": { "type": ["string", "null"] },
          "tolerance_json": { "type": ["string", "null"] },
          "verification_status": { "type": "string", "const": "manual_review" }
        },
        "additionalProperties": false
      }
    },
    "assertion_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assertion_fingerprint", "decision", "canonical_field_ids", "reason"],
        "properties": {
          "assertion_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "decision": { "type": "string", "enum": ["included", "conflict", "irrelevant"] },
          "canonical_field_ids": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
